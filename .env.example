DATABASE_URL=postgresql://postgres:postgres@localhost:5432/nalar
BETTER_AUTH_SECRET=replace-with-at-least-32-characters
BETTER_AUTH_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173
TRUSTED_ORIGIN=http://localhost:5173
GEMINI_API_KEY=replace-with-gemini-api-key
GOOGLE_CLIENT_ID=replace-with-google-oauth-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-oauth-client-secret

# Uploaded PDFs. Locally the default is the ./uploads directory (UPLOAD_DIR to move it).
# Production uses an S3-compatible bucket (Cloudflare R2): set STORAGE_DRIVER=s3 and the rest.
# STORAGE_DRIVER=s3
# STORAGE_DRIVER=s3
# S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# S3_BUCKET=nalar-files
# S3_ACCESS_KEY_ID=replace-with-r2-access-key-id
# S3_SECRET_ACCESS_KEY=replace-with-r2-secret-access-key
# S3_REGION=auto
